# Copy this file to .env before deployment, then replace the password.
# PostgreSQL stores drawing metadata, annotations and the symbol catalog.
POSTGRES_USER=pid_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=pid_db

# MinIO stores original drawing files in a persistent volume.
MINIO_ROOT_USER=pid_minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_BUCKET=pid-drawings

# Host ports deliberately avoid common development ports.
FRONTEND_HOST_PORT=18731
BACKEND_HOST_PORT=18732
DATABASE_HOST_PORT=18733
REDIS_HOST_PORT=18734
MINIO_HOST_PORT=18735
MINIO_CONSOLE_HOST_PORT=18736
